        </mxCell>
        <mxCell id="engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;" value="&lt;b&gt;Flow engine&lt;/b&gt;&lt;br&gt;Versioned DAG. The board is only its projection." vertex="1">
          <mxGeometry height="504" width="640" x="-690" y="592" as="geometry" />
        </mxCell>
        <mxCell id="engine-1" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Flow = versioned DAG&lt;/b&gt;&lt;br&gt;Editing creates a new version. Tasks pin flow_id at start; in-flight tasks never move." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="52" as="geometry" />
        </mxCell>
        <mxCell id="engine-2" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Step def → step instance → run&lt;/b&gt;&lt;br&gt;Rework loops create attempt 2, 3, 4 against the same instance." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="52" as="geometry" />
        </mxCell>
        <mxCell id="engine-3" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Advance modes&lt;/b&gt;&lt;br&gt;auto · wait for approval · wait for answers (park / resume via prompt replay)." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="164" as="geometry" />
        </mxCell>
        <mxCell id="engine-4" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Parallel branches + join&lt;/b&gt;&lt;br&gt;Card sits at the split point and shows which branches are active." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="164" as="geometry" />
        </mxCell>
        <mxCell id="engine-5" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;D3 · max_attempts = attempts allowed&lt;/b&gt;&lt;br&gt;Fail on the 4th (default 3). Loops are guarded." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="engine-6" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Artifact contracts&lt;/b&gt;&lt;br&gt;requires / produces declared per step, validated at design time." vertex="1">
