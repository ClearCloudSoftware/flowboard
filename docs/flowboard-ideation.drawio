  <diagram name="Harness architecture" id="flowboard-harness-architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="&lt;b style='font-size:20px'&gt;Harness architecture — how v3 would be built&lt;/b&gt;&lt;br&gt;One laptop · two Node processes · one SQLite file · one throwaway Docker container per run. Numbered badges map to the harness-engineering concepts (right); lettered arrows trace the life of one step. Dashed = optional or later. Code is one pnpm workspace with a framework-free core (bottom of the host)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="2300" height="60" as="geometry" /></mxCell>
        <mxCell id="fe" value="&lt;b&gt;Browser  ·  front end&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#2f6fed;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1520" height="190" as="geometry" /></mxCell>
        <mxCell id="fe-0" value="&lt;b&gt;Board  /p/[slug]&lt;/b&gt;&lt;br&gt;columns come from the flow; drag only Backlog ↔ Todo" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="16" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-1" value="&lt;b&gt;Inbox  /inbox&lt;/b&gt;&lt;br&gt;questions, approval gates, escalated loops; j / k, 1–9, Enter" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="266" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-1-b0" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="474" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="fe-2" value="&lt;b&gt;Task detail  /t/[id]&lt;/b&gt;&lt;br&gt;step timeline, attempts, artifacts, plan vs built diff" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="516" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-3" value="&lt;b&gt;Flow designer  /p/[slug]/flow&lt;/b&gt;&lt;br&gt;xyflow canvas; live requires / produces check" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="766" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-3-b0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="974" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="fe-4" value="&lt;b&gt;Run viewer  /runs/[id]&lt;/b&gt;&lt;br&gt;streamed events, live cost, Stop" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="1016" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-5" value="&lt;b&gt;Library · Costs · Settings&lt;/b&gt;&lt;br&gt;skills &amp; agents, spend + wasted spend, draft mode, sandbox tier" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="1266" y="40" width="236" height="64" as="geometry" /></mxCell>
        <mxCell id="fe-tech" value="&lt;b&gt;Tech&lt;/b&gt;&lt;br&gt;React 19 · Next.js App Router, current major at build time (server components + client islands) · TypeScript · shadcn/ui + Tailwind (light, zero radius, IBM Plex) · xyflow for the designer · EventSource for live updates · no client state store: the server is the source of truth" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="16" y="116" width="1486" height="56" as="geometry" /></mxCell>
        <mxCell id="host" value="&lt;b&gt;Your machine  ·  macOS host&lt;/b&gt;   (pnpm dev → concurrently starts both processes)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1520" height="980" as="geometry" /></mxCell>
        <mxCell id="nx" value="&lt;b&gt;Process 1  ·  apps/web (Next.js)&lt;/b&gt;   thin: validates, calls core, enqueues; never spawns agents" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#a06cf0;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="host"><mxGeometry x="16" y="40" width="600" height="330" as="geometry" /></mxCell>
        <mxCell id="nx-api" value="&lt;b&gt;API routes + server actions&lt;/b&gt;&lt;br&gt;zod-validated input → write rows → enqueue a job → return" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="nx"><mxGeometry x="16" y="40" width="568" height="56" as="geometry" /></mxCell>
        <mxCell id="nx-sse" value="&lt;b&gt;SSE endpoints&lt;/b&gt;&lt;br&gt;tail run_events by seq, questions and task state from SQLite (works across processes; catches up on reconnect)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="nx"><mxGeometry x="16" y="106" width="568" height="64" as="geometry" /></mxCell>
        <mxCell id="nx-read" value="&lt;b&gt;Read models&lt;/b&gt;&lt;br&gt;board projection (furthest-advanced step, split badges) · cost rollups incl. wasted spend" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="nx"><mxGeometry x="16" y="180" width="568" height="56" as="geometry" /></mxCell>
        <mxCell id="nx-val" value="&lt;b&gt;Flow validation on save&lt;/b&gt;&lt;br&gt;every requires is produced by an ancestor · edits create a new flow version; running tasks keep theirs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="nx"><mxGeometry x="16" y="246" width="568" height="64" as="geometry" /></mxCell>
        <mxCell id="nx-val-b0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="nx"><mxGeometry x="556" y="251" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="data" value="&lt;b&gt;Durable state  ·  host filesystem&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#3bb273;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="host"><mxGeometry x="16" y="390" width="600" height="494" as="geometry" /></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLite  data/flowboard.db   (better-sqlite3 + Drizzle · WAL · busy_timeout 5 s)&lt;/b&gt;&lt;br&gt;projects (check_command) · flows · step_defs (kind, command, max_attempts) · step_edges&lt;br&gt;tasks (acceptance_criteria, non_goals) · step_instances (attempts, outcome)&lt;br&gt;runs (attempt, fingerprint, wasted, cost, tokens, sandbox) · run_events (v, seq)&lt;br&gt;questions · artifacts · jobs (run_after, lease) · settings (memory, sandbox_profile) · run_memories · memories + FTS5&lt;br&gt;&lt;i&gt;the only shared state: opened by apps/web and apps/worker only, never from a sandbox&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="data"><mxGeometry x="16" y="40" width="568" height="140" as="geometry" /></mxCell>
        <mxCell id="db-b0" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="data"><mxGeometry x="556" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="git" value="&lt;b&gt;Project repo + git worktrees&lt;/b&gt;&lt;br&gt;&amp;lt;repo&amp;gt;/.flowboard/worktrees/task-&amp;lt;id&amp;gt; on branch fb/task-&amp;lt;id&amp;gt;&lt;br&gt;artifacts: .vibe/task-&amp;lt;id&amp;gt;/*.md | *.json, committed alongside the code" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="data"><mxGeometry x="16" y="196" width="568" height="80" as="geometry" /></mxCell>
        <mxCell id="git-b0" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="data"><mxGeometry x="556" y="201" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="skills" value="&lt;b&gt;Capability library&lt;/b&gt;&lt;br&gt;skills/&amp;lt;slug&amp;gt;/SKILL.md as plugin dirs · agent definitions" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="data"><mxGeometry x="16" y="290" width="278" height="80" as="geometry" /></mxCell>
        <mxCell id="runsnap" value="&lt;b&gt;Run records&lt;/b&gt;&lt;br&gt;data/runs/&amp;lt;id&amp;gt;/spec.json + raw stream, replayable at $0" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="data"><mxGeometry x="306" y="290" width="278" height="80" as="geometry" /></mxCell>
        <mxCell id="ka" value="&lt;b&gt;Knowledge assets (later)&lt;/b&gt;&lt;br&gt;repomix pack · Serena index · graphify-out/, stamped with the build SHA, refreshed by scheduled shell-step flows" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="data"><mxGeometry x="16" y="384" width="568" height="80" as="geometry" /></mxCell>
        <mxCell id="ka-b0" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="data"><mxGeometry x="556" y="389" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk" value="&lt;b&gt;Process 2  ·  apps/worker (Node)&lt;/b&gt;   the harness proper; its rules come from packages/core" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#a06cf0;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="host"><mxGeometry x="636" y="40" width="868" height="840" as="geometry" /></mxCell>
        <mxCell id="wk-jobs" value="&lt;b&gt;Job loop&lt;/b&gt;&lt;br&gt;lease from jobs (UPDATE … RETURNING) · VIBE_MAX_RUNS cap · on restart re-attach by pid · start_run, advance_task, escalate_question, import_backlog" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="40" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-engine" value="&lt;b&gt;Flow engine&lt;/b&gt;&lt;br&gt;advance_task: always / on_pass / on_fail · fan-out + join · approval and answer gates · &lt;b&gt;no outcome → gate, never pass&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="40" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-engine-b0" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="541" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-loop" value="&lt;b&gt;Loop guard&lt;/b&gt;&lt;br&gt;attempts counted on the rework target, shared by every loop into it · max_attempts 3 = total runs · same check fingerprint twice → escalate · gate: Retry + note / Fail task" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="582" y="40" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-loop-b0" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="824" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-runner" value="&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;builds the RunSpec · draft-mode transform · writes per-run mcp.json + settings.json (hooks) · records model, effort, tier" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="158" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-prompt" value="&lt;b&gt;Prompt builder&lt;/b&gt;&lt;br&gt;1 task + acceptance criteria + non-goals · 2 read-these-first paths · 3 output paths · 4 /skill · 5 template · 6 headless: use ask_user · +7 recalled memory, ≤ max_recall_chars" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="158" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-prompt-b0" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="541" y="163" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-prompt-b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="515" y="163" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-gate" value="&lt;b&gt;Permission gate&lt;/b&gt;&lt;br&gt;bypassPermissions only when the tier is container / gVisor / microVM; host tier → approval mode · budget caps map to --memory / --cpus / --pids-limit" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="582" y="158" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-gate-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="824" y="163" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-agent" value="&lt;b&gt;AgentProvider port&lt;/b&gt;&lt;br&gt;Claude CLI adapter (claude -p, stream-json) · Codex (later) · ReplayProvider at $0 · &lt;b&gt;spike first: could this port be ACP?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="276" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-shell" value="&lt;b&gt;Shell executor  =  the sensor&lt;/b&gt;&lt;br&gt;runs check_command in a fresh sandbox · exit 0 → pass, else fail · output tail → check_output · fingerprint → runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="276" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-shell-b0" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="541" y="281" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-retry" value="&lt;b&gt;Infra-retry classifier&lt;/b&gt;&lt;br&gt;non-zero agent exit: transient → same attempt again after 30 s / 2 m / 8 m, wasted = 1, not counted · anything else → task blocked" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="582" y="276" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-retry-b0" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="824" y="281" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-parse" value="&lt;b&gt;Stream parser&lt;/b&gt;&lt;br&gt;stream-json → NormalizedEvent v1 (versioned, OTel GenAI names) → run_events · live token and cost" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="394" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-scan" value="&lt;b&gt;Artifact scanner&lt;/b&gt;&lt;br&gt;files with mtime ≥ run start, matched to produces · declare_artifact · reads {outcome}" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="394" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-ws" value="&lt;b&gt;Workspace manager&lt;/b&gt;&lt;br&gt;git worktree add / remove per task · ExecHost per tier: host · docker · gVisor" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="582" y="394" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-ws-b0" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="824" y="399" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-broker" value="&lt;b&gt;ask_user broker&lt;/b&gt;&lt;br&gt;only writer of questions · one unix socket per run · same path on every tier, host included · 20 min unanswered → park; resume with --resume" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="512" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-broker-b0" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="258" y="517" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-mem" value="&lt;b&gt;MemoryStore port&lt;/b&gt;&lt;br&gt;recall before launch (user + project + agent + task) · write after success from artifacts + answers only · adapters: none (default) · local SQLite FTS5 (first) · mem0 (later)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="512" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-mem-b0" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="541" y="517" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-notify" value="&lt;b&gt;Escalation + Notifier&lt;/b&gt;&lt;br&gt;escalate_question after 5 min · Slack Socket Mode + Block Kit, so no public URL · first answer wins, web or Slack" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="582" y="512" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-notify-b0" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="824" y="517" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="wk-cost" value="&lt;b&gt;Cost ledger&lt;/b&gt;&lt;br&gt;result-event cost is authoritative · wasted = rework + infra retries · memory cost tagged separately" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="630" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-import" value="&lt;b&gt;Backlog import&lt;/b&gt;&lt;br&gt;backlog-importer agent → {import_key, title, body, acceptance_criteria, non_goals} → upsert" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="299" y="630" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-sched" value="&lt;b&gt;Schedule trigger (later)&lt;/b&gt;&lt;br&gt;cron-style rows in jobs → maintenance flows: knowledge-asset refresh, nightly gates" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="wk"><mxGeometry x="582" y="630" width="270" height="108" as="geometry" /></mxCell>
        <mxCell id="wk-test" value="&lt;b&gt;Test lane&lt;/b&gt;&lt;br&gt;vitest on engine rules, fingerprinting and the prompt builder · ReplayProvider drives whole flows at $0 · Playwright E2E against the real UI (v1 shipped without one)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="wk"><mxGeometry x="16" y="748" width="836" height="64" as="geometry" /></mxCell>
        <mxCell id="code" value="&lt;b&gt;Code layout  ·  one pnpm workspace&lt;/b&gt;&lt;br&gt;&lt;b&gt;packages/core&lt;/b&gt;: engine, loop guard, prompt builder, fingerprint, ports, NormalizedEvent; imports no framework, no DB driver, no CLI · &lt;b&gt;packages/db&lt;/b&gt;: Drizzle schema + migrations · &lt;b&gt;packages/adapters&lt;/b&gt;: agent · exec · notify · memory · &lt;b&gt;apps/web&lt;/b&gt; · &lt;b&gt;apps/worker&lt;/b&gt; · &lt;b&gt;apps/mcp-shim&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="host"><mxGeometry x="16" y="900" width="1488" height="64" as="geometry" /></mxCell>
        <mxCell id="dk" value="&lt;b&gt;Docker Desktop  ·  Linux VM&lt;/b&gt;   one container per run, destroyed on exit" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#e2b93b;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="320" width="760" height="980" as="geometry" /></mxCell>
        <mxCell id="sb" value="&lt;b&gt;Agent sandbox  ·  image flowboard-runner&lt;/b&gt;   node · claude CLI · codex CLI · git · pnpm · toolchains" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#e2b93b;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="dk"><mxGeometry x="16" y="40" width="728" height="492" as="geometry" /></mxCell>
        <mxCell id="sb-claude" value="&lt;b&gt;claude -p … --output-format stream-json&lt;/b&gt;&lt;br&gt;cwd /work · --mcp-config (shim) · --settings (hooks) · --strict-mcp-config · --max-turns · --max-budget-usd · ANTHROPIC_BASE_URL → proxy, dummy key" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="16" y="40" width="340" height="100" as="geometry" /></mxCell>
        <mxCell id="sb-shim" value="&lt;b&gt;ask_user MCP shim (stdio)&lt;/b&gt;&lt;br&gt;forwards tool calls over /run/fb/ask.sock to the host broker; no DB file, no network. Same shim on the host tier" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="372" y="40" width="340" height="100" as="geometry" /></mxCell>
        <mxCell id="sb-shim-b0" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="684" y="45" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="sb-mounts" value="&lt;b&gt;Mounts&lt;/b&gt;&lt;br&gt;rw: task worktree → /work&lt;br&gt;ro: skills/ → /skills&lt;br&gt;socket: ask.sock&lt;br&gt;&lt;b&gt;never&lt;/b&gt;: ~/.ssh, cloud credentials, flowboard.db, docker.sock" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="16" y="150" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="sb-mounts-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="328" y="155" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="sb-hard" value="&lt;b&gt;Hardening&lt;/b&gt;&lt;br&gt;non-root user · --cap-drop ALL · no-new-privileges · read-only root + tmpfs /tmp · --memory / --cpus / --pids-limit · wall-clock kill · no real credential inside" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="372" y="150" width="340" height="120" as="geometry" /></mxCell>
        <mxCell id="sb-hard-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="684" y="155" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="sb-hooks" value="&lt;b&gt;PreToolUse hooks  ·  the in-agent gate&lt;/b&gt;&lt;br&gt;deny writes outside /work and to non-goal paths · deny git push, rm -rf outside /work, curl | sh · the reason goes back to the agent so it changes course" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="16" y="280" width="696" height="64" as="geometry" /></mxCell>
        <mxCell id="sb-hooks-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="684" y="285" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="sb-tiers" value="&lt;b&gt;Tiers&lt;/b&gt;&lt;br&gt;host (no box, approval mode only) · container (default when autonomous) · gVisor runsc (untrusted repos, Linux hosts) · microVM / docker sandbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="16" y="354" width="696" height="56" as="geometry" /></mxCell>
        <mxCell id="sb-check" value="&lt;b&gt;Check container&lt;/b&gt;&lt;br&gt;same image and mounts, no model, no API key: runs check_command and exits with its code" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="16" y="420" width="696" height="56" as="geometry" /></mxCell>
        <mxCell id="sb-check-b0" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="sb"><mxGeometry x="684" y="425" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="proxy" value="&lt;b&gt;Egress proxy  (Squid / tinyproxy)&lt;/b&gt;&lt;br&gt;fb-sandbox is an internal Docker network, so the proxy is the only way out&lt;br&gt;injects the real API key on model requests · allowlist: api.anthropic.com · api.openai.com (later) · npm / PyPI · no git remote" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="dk"><mxGeometry x="16" y="552" width="350" height="136" as="geometry" /></mxCell>
        <mxCell id="proxy-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="dk"><mxGeometry x="338" y="557" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="mem0" value="&lt;b&gt;Mem0 OSS server (later)&lt;/b&gt;&lt;br&gt;only once local memory pays off · on fb-memory, reachable from the host only, never from the sandbox&lt;br&gt;its extraction LLM is metered separately" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="dk"><mxGeometry x="394" y="552" width="350" height="136" as="geometry" /></mxCell>
        <mxCell id="mem0-b0" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="dk"><mxGeometry x="716" y="557" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="langfuse" value="&lt;b&gt;Langfuse (later)&lt;/b&gt;&lt;br&gt;self-hosted traces via a plain OTel exporter from NormalizedEvent" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="dk"><mxGeometry x="16" y="704" width="350" height="72" as="geometry" /></mxCell>
        <mxCell id="guard" value="&lt;b&gt;Injection scan (later)&lt;/b&gt;&lt;br&gt;LLM Guard over artifacts before the next step or memory trusts them" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="dk"><mxGeometry x="394" y="704" width="350" height="72" as="geometry" /></mxCell>
        <mxCell id="guard-b0" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="dk"><mxGeometry x="716" y="709" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="gates" value="&lt;b&gt;Deterministic gates (later)&lt;/b&gt;&lt;br&gt;semgrep · gitleaks · trivy · eslint / ruff as extra shell steps: $0 catches before any model reviews" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="dk"><mxGeometry x="16" y="792" width="728" height="64" as="geometry" /></mxCell>
        <mxCell id="gates-b0" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="dk"><mxGeometry x="716" y="797" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="ext" value="&lt;b&gt;External services&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#5f6675;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="2320" height="130" as="geometry" /></mxCell>
        <mxCell id="x-anth" value="&lt;b&gt;Anthropic API&lt;/b&gt;&lt;br&gt;only via the claude CLI and the proxy, which holds the key" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="ext"><mxGeometry x="16" y="46" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="x-oai" value="&lt;b&gt;OpenAI&lt;/b&gt;&lt;br&gt;Codex CLI adapter (later)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="ext"><mxGeometry x="346" y="46" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="x-reg" value="&lt;b&gt;Package registries&lt;/b&gt;&lt;br&gt;npm · PyPI, through the proxy" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="ext"><mxGeometry x="676" y="46" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="x-gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;skill install (git clone) · project remote" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="ext"><mxGeometry x="1006" y="46" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="x-slack" value="&lt;b&gt;Slack&lt;/b&gt;&lt;br&gt;Socket Mode WebSocket, outbound only" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="ext"><mxGeometry x="1336" y="46" width="300" height="64" as="geometry" /></mxCell>
        <mxCell id="e-a" value="A  HTTP · server actions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#2f6fed;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fe-tech" target="nx-api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-b" value="B  write rows + enqueue job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nx-api" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-c" value="C  lease job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-jobs" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-sse" value="G  SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#2f6fed;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="nx-sse" target="fe-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-sse-db" value="tail by seq" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="db" target="nx-sse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d" value="D  recall / write (local adapter)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-mem" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d2" value="later" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="wk-mem" target="mem0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-e" value="E  docker run via ExecHost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#e2b93b;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-gate" target="sb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f" value="F  HTTPS_PROXY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#e2b93b;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sb-claude" target="proxy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#e2b93b;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proxy" target="x-anth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#e2b93b;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="proxy" target="x-reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-g" value="G  stream-json on stdout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sb-claude" target="wk-parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-g2" value="run_events + cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-parse" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-h" value="H  ask.sock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sb-shim" target="wk-broker"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-h2" value="questions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#a06cf0;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-broker" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-h3" value="H  Block Kit after 5 min" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#5f6675;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-notify" target="x-slack"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-i" value="I  run check_command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#e2b93b;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-shell" target="sb-check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-i2" value="I  artifacts + outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-scan" target="git"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ws" value="worktree add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wk-ws" target="git"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-mount" value="bind mount /work" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#3bb273;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="git" target="sb-mounts"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-skills" value="install" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#5f6675;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="skills" target="x-gh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-git" value="host-side push / fetch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=6;strokeColor=#5f6675;fontSize=10;fontColor=#1c1f26;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="git" target="x-gh"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hm" value="&lt;b&gt;Harness-engineering concepts  →  where they live&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#1c1f26;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2400" y="90" width="600" height="640" as="geometry" /></mxCell>
        <mxCell id="hm-b0" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="46" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t0" value="&lt;b&gt;Bounded contract&lt;/b&gt;&lt;br&gt;Acceptance criteria and non-goals on the task; requires / produces, budget, turns and tools on the step. Fixed before generation, checked at flow save, injected by the prompt builder." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="40" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b1" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="118" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t1" value="&lt;b&gt;Map, not encyclopedia&lt;/b&gt;&lt;br&gt;The prompt lists paths to read, not their contents. Recalled memory is capped. Knowledge assets (repomix, Serena) come later as maps of the repo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="112" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b2" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="190" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t2" value="&lt;b&gt;Durable memory&lt;/b&gt;&lt;br&gt;State lives in SQLite, artifacts are git-tracked files, sessions park and resume, and a memory store (local first, Mem0 later) carries lessons across tasks. Nothing lives only in a context window." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="184" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b3" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="262" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t3" value="&lt;b&gt;Sensors before autonomy&lt;/b&gt;&lt;br&gt;Check steps run real commands. The exit code is the verdict, and the raw output feeds the next attempt. Later: semgrep, gitleaks and linters as more $0 sensors." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="256" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b4" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="334" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t4" value="&lt;b&gt;Dual encoding&lt;/b&gt;&lt;br&gt;The prompt says “stay in scope, ask through ask_user”; two gates enforce it: hooks inside the agent (no writes outside /work or to non-goals, no push) and the box outside (no bypass on the host, egress allowlist, no real keys)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="328" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b5" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="406" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t5" value="&lt;b&gt;Loop layer&lt;/b&gt;&lt;br&gt;Rework edges share one attempt budget, a repeated fingerprint escalates early, infra retries stay out of the count, and a missing outcome is never a pass." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="400" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b6" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="478" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t6" value="&lt;b&gt;Graph layer&lt;/b&gt;&lt;br&gt;A versioned DAG: one agent per step with a fresh context, parallel branches in the task's own worktree, and an adversarial review only after the check passes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="472" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="hm-b7" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="hm"><mxGeometry x="16" y="550" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="hm-t7" value="&lt;b&gt;Human escalation&lt;/b&gt;&lt;br&gt;Every stop (gate, question, spent or stuck loop) lands in one inbox, then Slack. Your call overrides the agent's." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="hm"><mxGeometry x="48" y="544" width="536" height="70" as="geometry" /></mxCell>
        <mxCell id="life" value="&lt;b&gt;Life of one step&lt;/b&gt;   (letters on the arrows)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#1c1f26;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2400" y="760" width="600" height="470" as="geometry" /></mxCell>
        <mxCell id="life-t" value="&lt;b&gt;A&lt;/b&gt;  You press Start, or the engine advances a task. A server action validates the request.&lt;br&gt;&lt;br&gt;&lt;b&gt;B&lt;/b&gt;  Next.js writes the task and step rows plus a start_run job, then returns. It never spawns anything.&lt;br&gt;&lt;br&gt;&lt;b&gt;C&lt;/b&gt;  The worker leases the job. The engine picks the step; the runner builds the RunSpec and the prompt: contract, read-first paths, output paths.&lt;br&gt;&lt;br&gt;&lt;b&gt;D&lt;/b&gt;  If memory is on, the runner recalls (capped) before launch and writes after success. Host side only.&lt;br&gt;&lt;br&gt;&lt;b&gt;E&lt;/b&gt;  The permission gate checks the tier; the runner writes mcp.json and the hook settings; the ExecHost starts a sandbox with the worktree at /work.&lt;br&gt;&lt;br&gt;&lt;b&gt;F&lt;/b&gt;  claude runs inside, holding only a dummy key. Every call leaves through the egress proxy, which checks the allowlist and adds the real key toward the model endpoint.&lt;br&gt;&lt;br&gt;&lt;b&gt;G&lt;/b&gt;  stream-json on stdout → parser → run_events + live cost → SSE → run viewer and board.&lt;br&gt;&lt;br&gt;&lt;b&gt;H&lt;/b&gt;  A question goes shim → ask.sock → broker → questions → Inbox, and to Slack after 5 minutes. After 20 minutes the agent parks and resumes later with --resume.&lt;br&gt;&lt;br&gt;&lt;b&gt;I&lt;/b&gt;  On exit: scan artifacts, read the outcome. A check step runs check_command in a fresh container and its exit code decides. The engine follows on_pass / on_fail and escalates when the loop is spent, stuck, or silent.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="life"><mxGeometry x="16" y="36" width="568" height="424" as="geometry" /></mxCell>
        <mxCell id="lg" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2400" y="1250" width="600" height="160" as="geometry" /></mxCell>
        <mxCell id="lg-s0" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="16" y="36" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t0" value="front end" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="52" y="33" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-s1" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="306" y="36" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t1" value="process logic" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="342" y="33" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-s2" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="16" y="66" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t2" value="durable state" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="52" y="63" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-s3" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="306" y="66" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t3" value="isolation / security" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="342" y="63" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-s4" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5f6675;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="16" y="96" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t4" value="external or observability" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="52" y="93" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-s5" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8a91a3;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;fontSize=11;dashed=1;" vertex="1" parent="lg"><mxGeometry x="306" y="96" width="28" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-t5" value="dashed border = optional or later" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="342" y="93" width="240" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-b" value="n" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1c1f26;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="lg"><mxGeometry x="16" y="128" width="18" height="18" as="geometry" /></mxCell>
        <mxCell id="lg-bt" value="harness concept (panel above)   ·   letter on an arrow = step in the life of a run" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1c1f26;spacing=4;" vertex="1" parent="lg"><mxGeometry x="42" y="125" width="540" height="22" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
