        <mxCell id="f-notify-1" parent="f-notify" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Verify inbound&lt;/b&gt;&lt;br&gt;signature check on interactions" vertex="1">
