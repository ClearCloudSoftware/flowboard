        <mxCell id="board-1" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Columns come from the flow&lt;/b&gt;&lt;br&gt;Backlog + Todo fixed in front, Done at the end. Order = board_order of the active flow version." vertex="1">
