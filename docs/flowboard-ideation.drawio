        </mxCell>
        <mxCell id="board-2" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Card at a glance&lt;/b&gt;&lt;br&gt;Title, current step, state dot (running / answers / approval / failed), live ticking cost, split badge." vertex="1">
          <mxGeometry height="94" width="290" x="322" y="52" as="geometry" />
        </mxCell>
        <mxCell id="board-3" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Drag only Backlog ↔ Todo&lt;/b&gt;&lt;br&gt;Everything downstream is engine-driven; dragging there would lie about what the system does." vertex="1">
          <mxGeometry height="94" width="290" x="16" y="164" as="geometry" />
        </mxCell>
        <mxCell id="board-4" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Task detail sheet&lt;/b&gt;&lt;br&gt;Step timeline (state, attempts, cost, duration), artifact links, Approve / Reject, plan.md vs summary.md diff." vertex="1">
          <mxGeometry height="94" width="290" x="322" y="164" as="geometry" />
        </mxCell>
        <mxCell id="board-5" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;D1 · Auto-start on promote?&lt;/b&gt;&lt;br&gt;Default: explicit Start button on card + sheet; promote stays cheap." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="board-6" parent="board" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#e2b93b;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;8+ columns don&#39;t fit&lt;/b&gt;&lt;br&gt;Horizontal scroll, but the columns that need me must stay findable. Jump-to-attention?" vertex="1">
          <mxGeometry height="76" width="290" x="322" y="276" as="geometry" />
        </mxCell>
        <mxCell id="inbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;" value="&lt;b&gt;Inbox  /inbox&lt;/b&gt;&lt;br&gt;Most-used screen. Latency here costs money." vertex="1">
          <mxGeometry height="504" width="640" x="580" y="-70" as="geometry" />
        </mxCell>
        <mxCell id="inbox-1" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;One queue, every project&lt;/b&gt;&lt;br&gt;Question text, help text, task, asking step, waiting time, link to the live session." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="52" as="geometry" />
        </mxCell>
        <mxCell id="inbox-2" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Five question types&lt;/b&gt;&lt;br&gt;yes/no · single select · multi select · text (⌘Enter) · number." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="52" as="geometry" />
        </mxCell>
        <mxCell id="inbox-3" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Batches, not cards&lt;/b&gt;&lt;br&gt;5–8 questions arrive from one step. Show them as one group to work down." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="164" as="geometry" />
        </mxCell>
        <mxCell id="inbox-4" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Waiting time → Slack at 5 min&lt;/b&gt;&lt;br&gt;Elapsed time legible at a glance without becoming the loudest thing on screen." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="164" as="geometry" />
        </mxCell>
        <mxCell id="inbox-5" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Keyboard model&lt;/b&gt;&lt;br&gt;j/k move · 1–9 pick · Enter submit. Cards resolve calmly when answered from Slack." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="inbox-6" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#a06cf0;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;D2 · Keep the 10 s undo window?&lt;/b&gt;&lt;br&gt;Default: drop from the MCP path; web-side undo only while no agent waits." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="276" as="geometry" />
        </mxCell>
        <mxCell id="inbox-7" parent="inbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Empty state shows what&#39;s running&lt;/b&gt;&lt;br&gt;Not a shrug illustration." vertex="1">
          <mxGeometry height="57" width="290" x="16" y="388" as="geometry" />
        </mxCell>
        <mxCell id="runs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;" value="&lt;b&gt;Runner &amp;amp; live viewer  /runs/[id]&lt;/b&gt;&lt;br&gt;One headless CLI session per run." vertex="1">
          <mxGeometry height="392" width="640" x="2370" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="runs-1" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Job queue + worker&lt;/b&gt;&lt;br&gt;Route handlers enqueue; the worker spawns processes. Becomes a fleet later, for free." vertex="1">
          <mxGeometry height="94" width="290" x="16" y="52" as="geometry" />
        </mxCell>
        <mxCell id="runs-2" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;stream-json → 7 event kinds&lt;/b&gt;&lt;br&gt;Parser written against docs/stream-sample.jsonl, not assumptions. Cost + tokens captured." vertex="1">
          <mxGeometry height="94" width="290" x="322" y="52" as="geometry" />
        </mxCell>
        <mxCell id="runs-3" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Live session viewer&lt;/b&gt;&lt;br&gt;Normalised events as they arrive; tool calls collapsible with full input / result." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="164" as="geometry" />
        </mxCell>
        <mxCell id="runs-4" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Sticky footer + Stop&lt;/b&gt;&lt;br&gt;Elapsed, turn count, running cost. Stop kills the process." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="164" as="geometry" />
        </mxCell>
        <mxCell id="runs-5" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;D5 · Hook isolation&lt;/b&gt;&lt;br&gt;Empty --settings file per headless run." vertex="1">
          <mxGeometry height="57" width="290" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="runs-6" parent="runs" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Git worktree per task&lt;/b&gt;&lt;br&gt;Workspace isolation. Artifacts live on disk, not in the DB." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="276" as="geometry" />
        </mxCell>
        <mxCell id="engine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#8a91a3;fillColor=#f4f5f8;fontColor=#5f6675;align=left;verticalAlign=top;spacing=8;container=1;" value="&lt;b&gt;Flow engine&lt;/b&gt;&lt;br&gt;Versioned DAG. The board is only its projection." vertex="1">
          <mxGeometry height="504" width="640" x="-690" y="592" as="geometry" />
        </mxCell>
        <mxCell id="engine-1" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Flow = versioned DAG&lt;/b&gt;&lt;br&gt;Editing creates a new version. Tasks pin flow_id at start; in-flight tasks never move." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="52" as="geometry" />
        </mxCell>
        <mxCell id="engine-2" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Step def → step instance → run&lt;/b&gt;&lt;br&gt;Rework loops create attempt 2, 3, 4 against the same instance." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="52" as="geometry" />
        </mxCell>
        <mxCell id="engine-3" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Advance modes&lt;/b&gt;&lt;br&gt;auto · wait for approval · wait for answers (park / resume via prompt replay)." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="164" as="geometry" />
        </mxCell>
        <mxCell id="engine-4" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Parallel branches + join&lt;/b&gt;&lt;br&gt;Card sits at the split point and shows which branches are active." vertex="1">
          <mxGeometry height="76" width="290" x="322" y="164" as="geometry" />
        </mxCell>
        <mxCell id="engine-5" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3bb273;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;D3 · max_attempts = attempts allowed&lt;/b&gt;&lt;br&gt;Fail on the 4th (default 3). Loops are guarded." vertex="1">
          <mxGeometry height="76" width="290" x="16" y="276" as="geometry" />
        </mxCell>
        <mxCell id="engine-6" parent="engine" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2f6fed;strokeWidth=2;fillColor=#ffffff;fontColor=#1c1f26;align=left;verticalAlign=top;spacing=6;" value="&lt;b&gt;Artifact contracts&lt;/b&gt;&lt;br&gt;requires / produces declared per step, validated at design time." vertex="1">
