{
  "name": "lamproom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:packages": "LAMPROOM_LIVE= node --test \"packages/*/test/*.test.ts\"",
    "typecheck:packages": "tsc -p packages",
    "test:live": "LAMPROOM_LIVE=1 node --test packages/adapters/test/claude-live.test.ts packages/adapters/test/opencode-live.test.ts packages/cli/test/cli-live.test.ts packages/cli/test/ask-live.test.ts packages/cli/test/flow-live.test.ts packages/cli/test/ollama-live.test.ts",
    "lr-run-agent": "node packages/cli/src/main.ts",
    "lr-run-flow": "node packages/cli/src/flow-main.ts",
    "lr-clean-workspace": "node packages/cli/src/workspace-main.ts",
    "lr-doctor": "node packages/cli/src/doctor-main.ts",
    "test:app": "node --test \"app/**/*.test.ts\"",
    "electron": "electron .",
    "electron:dev": "electron . --dev"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-store": "0.11.2",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "^1.62.0",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "next": "16.4.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.23.0"
}
